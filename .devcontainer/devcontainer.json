{
  "name": "catasterism",
  // Context is the repo root so the image can bake pipeline/requirements.txt
  // rather than keeping a duplicate copy in .devcontainer/.
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },

  // Only this repo is mounted. Nothing else from the host filesystem is visible.
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",

  // Named Docker volumes (not host paths) so login + history survive rebuilds
  // without exposing anything outside the repo.
  "mounts": [
    "source=catasterism-claude-config,target=/home/dev/.claude,type=volume",
    "source=catasterism-bash-history,target=/commandhistory,type=volume"
  ],

  // The Claude Code extension is installed into the container, not inherited
  // from the host -- a devcontainer gets its own extension host.
  "customizations": {
    "vscode": {
      "extensions": ["anthropic.claude-code"],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },

  "remoteUser": "dev",
  "containerUser": "dev",

  "runArgs": [
    "--security-opt=no-new-privileges",
    "--cap-drop=ALL"
  ],

  "containerEnv": {
    "HISTFILE": "/commandhistory/.bash_history"
  }
}
